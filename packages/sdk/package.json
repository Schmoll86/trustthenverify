{
  "name": "@trustthenverify/sdk",
  "version": "0.3.0",
  "description": "TypeScript SDK for the TrustThenVerify escrow + verification protocol (v2)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./channels": {
      "import": "./dist/channels.js",
      "types": "./dist/channels.d.ts"
    },
    "./observations": {
      "import": "./dist/observations.js",
      "types": "./dist/observations.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest"
  },
  "keywords": [
    "ai-agents",
    "trust",
    "escrow",
    "verification",
    "trustthenverify",
    "mcp",
    "autonomous-agents"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Schmoll86/trustthenverify.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@noble/hashes": "^2.0.1",
    "@noble/secp256k1": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
